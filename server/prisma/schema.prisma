generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. SISTEMA CENTRAL (Autenticación y Personas)
// ==========================================

enum Role {
  SUPERADMIN
  EMPLEADO
  USUARIO
}

// Tabla para el Login de los empleados, administradores y clientes
model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(USUARIO)
  
  persona   Persona? 
}

// La "Fuente de la Verdad" de los datos duros
model Persona {
  id        Int      @id @default(autoincrement())
  dni       String   @unique
  nombre    String
  apellido  String
  telefono  String?
  
  usuarioId Int?     @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  // Relaciones con los distintos módulos
  socioGym         SocioGym?
  clienteFitMarket ClienteFitMarket?
}

// ==========================================
// 2. MÓDULO: INFINITY ACADEMIA (Gimnasio)
// ==========================================

model SocioGym {
  id              Int       @id @default(autoincrement())
  
  // Referencia a la tabla Persona
  personaId       Int       @unique
  persona         Persona   @relation(fields: [personaId], references: [id])
  
  estadoCuota     Boolean   @default(false)
  fechaVencimiento DateTime?
}

// ==========================================
// 3. MÓDULO: FITMARKET (Suplementos)
// ==========================================

enum TipoClienteMarket {
  MINORISTA
  MAYORISTA
  SOCIO_GYM
}

model ClienteFitMarket {
  id          Int               @id @default(autoincrement())
  
  // Referencia a la tabla Persona
  personaId   Int               @unique
  persona     Persona           @relation(fields: [personaId], references: [id])
  
  tipo        TipoClienteMarket @default(MINORISTA)
  deuda       Decimal           @default(0.0) 

  // Historial del cliente
  ventas      Venta[]
  pedidos     Pedido[]
}

model Producto {
  id              Int       @id @default(autoincrement())
  nombre          String
  descripcion     String?
  marca           String?
  stock           Int       @default(0)
  stockMinimo     Int       @default(5) 
  
  // Precios
  precioCosto     Decimal
  precioMayorista Decimal
  precioPublico   Decimal

  detallesVenta   DetalleVenta[]
  detallesPedido  DetallePedido[]
}

enum EstadoVenta {
  SEPARADO
  RETIRADO
}

model Venta {
  id              Int               @id @default(autoincrement())
  fecha           DateTime          @default(now())
  estado          EstadoVenta       @default(RETIRADO)
  medioPago       String            
  total           Decimal
  
  clienteId       Int
  cliente         ClienteFitMarket  @relation(fields: [clienteId], references: [id])

  detalles        DetalleVenta[]
}

model DetalleVenta {
  id              Int       @id @default(autoincrement())
  cantidad        Int
  precioUnitario  Decimal   // Para congelar el precio histórico
  
  ventaId         Int
  venta           Venta     @relation(fields: [ventaId], references: [id])
  
  productoId      Int
  producto        Producto  @relation(fields: [productoId], references: [id])
}

enum EstadoPedido {
  PENDIENTE
  RECHAZADO
}

model Pedido {
  id              Int               @id @default(autoincrement())
  fecha           DateTime          @default(now())
  estado          EstadoPedido      @default(PENDIENTE)
  
  clienteId       Int
  cliente         ClienteFitMarket  @relation(fields: [clienteId], references: [id])
  
  detalles        DetallePedido[]
}

model DetallePedido {
  id              Int       @id @default(autoincrement())
  cantidad        Int
  
  pedidoId        Int
  pedido          Pedido    @relation(fields: [pedidoId], references: [id])
  
  productoId      Int
  producto        Producto  @relation(fields: [productoId], references: [id])
}