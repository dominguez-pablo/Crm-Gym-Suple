generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. SISTEMA CENTRAL (Autenticación y Personas)
// ==========================================

enum Role {
  SUPERADMIN
  EMPLEADO
  USUARIO
}

model Usuario {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(USUARIO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  persona   Persona?
  traslados TrasladoStock[]
}

model Persona {
  id        Int      @id @default(autoincrement())
  dni       String   @unique
  nombre    String
  apellido  String
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarioId Int?     @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  socioGym         SocioGym?
  clienteFitMarket ClienteFitMarket?

  @@index([apellido])
}

// ==========================================
// 2. MÓDULO: INFINITY ACADEMIA (Gimnasio)
// ==========================================

model SocioGym {
  id               Int       @id @default(autoincrement())
  personaId        Int       @unique
  persona          Persona   @relation(fields: [personaId], references: [id])
  estadoCuota      Boolean   @default(false)
  fechaVencimiento DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ==========================================
// 3. MÓDULO: FITMARKET (Suplementos)
// ==========================================

enum TipoClienteMarket {
  MINORISTA
  MAYORISTA
  SOCIO_GYM
}

model ClienteFitMarket {
  id        Int               @id @default(autoincrement())
  personaId Int               @unique
  persona   Persona           @relation(fields: [personaId], references: [id])
  tipo      TipoClienteMarket @default(MINORISTA)
  deuda     Decimal           @default(0.0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  ventas  Venta[]
  pedidos Pedido[]
}

model Sucursal {
  id        Int      @id @default(autoincrement())
  nombre    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks           StockSucursal[]
  ventas           Venta[]
  trasladosOrigen  TrasladoStock[] @relation("TrasladoOrigen")
  trasladosDestino TrasladoStock[] @relation("TrasladoDestino")
}

model StockSucursal {
  id          Int      @id @default(autoincrement())
  cantidad    Int      @default(0)
  stockMinimo Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sucursalId Int
  sucursal   Sucursal @relation(fields: [sucursalId], references: [id])
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@unique([sucursalId, productoId])
  @@index([productoId])
}

model TrasladoStock {
  id        Int      @id @default(autoincrement())
  cantidad  Int
  nota      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  sucursalOrigenId Int
  sucursalOrigen   Sucursal @relation("TrasladoOrigen", fields: [sucursalOrigenId], references: [id])

  sucursalDestinoId Int
  sucursalDestino   Sucursal @relation("TrasladoDestino", fields: [sucursalDestinoId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([productoId])
  @@index([createdAt])
}

model Producto {
  id                Int      @id @default(autoincrement())
  nombre            String
  descripcion       String?
  marca             String?
  precioCosto       Decimal
  precioMayorista   Decimal
  precioRecomendado Decimal  @default(0)
  precioPublico     Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stocks         StockSucursal[]
  traslados      TrasladoStock[]
  detallesVenta  DetalleVenta[]
  detallesPedido DetallePedido[]

  @@index([nombre])
}

enum EstadoVenta {
  SEPARADO
  RETIRADO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  CONSIGNACION
  OTRO
}

model Venta {
  id        Int               @id @default(autoincrement())
  fecha     DateTime          @default(now())
  estado    EstadoVenta       @default(RETIRADO)
  medioPago String
  total     Decimal
  clienteId Int?
  cliente   ClienteFitMarket? @relation(fields: [clienteId], references: [id])
  sucursalId Int
  sucursal   Sucursal         @relation(fields: [sucursalId], references: [id])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  detalles DetalleVenta[]
  pagos    PagoVenta[]

  @@index([fecha])
  @@index([clienteId])
  @@index([sucursalId])
}

model PagoVenta {
  id        Int       @id @default(autoincrement())
  medio     MedioPago
  monto     Decimal
  cuotas    Int?
  nota      String?
  ventaId   Int
  venta     Venta     @relation(fields: [ventaId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ventaId])
}

model DetalleVenta {
  id             Int      @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal
  ventaId        Int
  venta          Venta    @relation(fields: [ventaId], references: [id])
  productoId     Int
  producto       Producto @relation(fields: [productoId], references: [id])
}

enum EstadoPedido {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Pedido {
  id        Int              @id @default(autoincrement())
  fecha     DateTime         @default(now())
  estado    EstadoPedido     @default(PENDIENTE)
  clienteId Int
  cliente   ClienteFitMarket @relation(fields: [clienteId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  detalles DetallePedido[]

  @@index([fecha])
  @@index([clienteId])
}

model DetallePedido {
  id         Int      @id @default(autoincrement())
  cantidad   Int
  pedidoId   Int
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
}
